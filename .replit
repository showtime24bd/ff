modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["gmp", "unzip"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web Control Panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Free Fire Game Bot"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Web Control Panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Free Fire Game Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80
